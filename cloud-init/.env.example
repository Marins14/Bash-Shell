# Copie para .env e preencha: cp .env.example .env && chmod 600 .env
# Nunca versione o .env.

# AWS - perfil da AWS CLI usado para criar a instância
# (a região é derivada da AZ; não defina AWS_REGION aqui)
AWS_PROFILE=exemplo-lightsail

# Lightsail
AZ=sa-east-1a

# Se não sabe os blueprints disponíveis, rode: aws lightsail get-blueprints --profile "$AWS_PROFILE" | jq -r '.blueprints[] | "\(.blueprintId) \(.name)"'
BLUEPRINT=ubuntu_24_04

# Usuário administrativo criado na VM e arquivo local com a(s) chave(s)
# pública(s) autorizada(s), uma por linha
ADMIN_USER=admin_user
ADMIN_PUBKEY_FILE=$HOME/.ssh/id_rsa.pub

# Timezone da VM (padrão: UTC)
TIMEZONE=UTC

# NetBird - NetBird Cloud por padrão; para self-hosted use a URL do seu management
NETBIRD_MANAGEMENT_URL=https://api.netbird.io
NB_GROUP=Servers
NETBIRD_API_TOKEN=nbp_substituir
